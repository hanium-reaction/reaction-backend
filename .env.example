# reaction-backend 환경변수 예시 (.env로 복사 후 사용)

# 실행 환경: local | dev | staging | prod
APP_ENV=local

# 앱 메타
APP_NAME=reaction-backend
APP_VERSION=0.1.0

# 서버 바인딩
HOST=0.0.0.0
PORT=8000

# CORS 허용 origin (JSON 배열로 입력)
CORS_ALLOW_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# CORS 패턴 매칭 (Vercel preview URL 등). 미사용이면 비워둔다.
# CORS_ALLOW_ORIGIN_REGEX=^https://reaction-frontend-.*\.vercel\.app$

# ───── DB (Issue #2) ─────

# Supabase Session pooler (Northeast Asia / Seoul) 권장
# 형태: postgresql://postgres.<project-ref>:<password>@aws-X-ap-northeast-2.pooler.supabase.com:5432/postgres
# 코드(db/session.py)가 자동으로 postgresql+asyncpg:// 로 변환합니다.
# 로컬 docker postgres로 개발 시: postgresql://reaction:reaction@localhost:5432/reaction
DATABASE_URL=

# SQL 쿼리 로그 (local 디버깅용). prod에선 반드시 false.
DB_ECHO=false

# ───── 후속 이슈에서 채워질 자리 ─────

# Issue #5 — LLM (Gemini)
GEMINI_API_KEY=
# ⚠️ **`-latest` alias 를 쓰지 말 것.** alias 는 Google 이 가리키는 대상을 말없이 바꾼다.
#    실제로 `gemini-flash-latest` 가 `gemini-3.6-flash` 로 올라가 있었고, 코드 변경 0건으로
#    모델·단가·기본 thinking 정책이 전부 바뀌었다. 자체 기록에는 요청한 alias 이름만 남아
#    청구서와 대조도 안 됐다. 모델 교체는 의도한 변경이어야 한다 — 고정 버전만 쓴다.
LLM_MODEL=gemini-3.5-flash-lite
# task 별 모델. 빈 값이면 base 로 폴백.
# 2026-08-03 부터 **전 모듈이 같은 모델(lite)** 이다. 아래 두 줄은 base 와 값이 같지만 그래도
# 비워두지 않는다 — 비우면 base 를 따라가서, 나중에 base 를 올릴 때 계획·회복이 같이 딸려
# 올라가 비용이 조용히 는다.
# 계획 분해는 lite 로 충분하다(실측 2026-08-02): 분해 계약(세션 수·세션 길이)을 flash 와
# 동일하게 지키면서 4배 싸고 더 빠르다(7.4s vs 9.9s).
# ⚠️ 회복은 원래 상위 flash 였고 "평가 전엔 안 내린다" 가 원칙이었다 — **아직 평가 안 했다.**
#    회복 카드 문구가 나빠지면 RECOVERY 만 gemini-3.5-flash 로 되돌리면 된다.
LLM_MODEL_PLANNING=gemini-3.5-flash-lite
LLM_MODEL_RECOVERY=gemini-3.5-flash-lite
LLM_TIMEOUT_SECONDS=8.0
LLM_MAX_RETRIES=3
# 계획(First Plan) 분해·검토 전용 thinking 예산(토큰) + timeout. 인터뷰 턴은 지연 민감이라
# thinking 0 유지, 계획만 추론을 켠다.
# 0 = thinking 끄기. 예산을 명시하지 않은 호출도 동일하게 thinking 을 쓰지 않는다 —
#    사고 토큰은 출력 요금으로 과금되므로 짧은 구조화 출력에서는 순수한 낭비다.
#    실측(2026-07-30): gemini-3.5-flash 는 0 을 받아들이고(사고 0), gemini-3.5-flash-lite 는
#    0 을 400 INVALID_ARGUMENT 로 거부한다(기본이 이미 사고 0). 두 계열의 기본값이 정반대라
#    provider `_thinking_config` 가 "0 = 끄기" 를 모델별 표현으로 번역한다 — 그래서 이 값을
#    0 으로 둬도 안전하다(예전에는 lite 에서 전 호출이 조용히 룰 폴백됐다).
# TIMEOUT 45초: 분해가 마감까지의 세션을 한 번에 만들면서 호출당 20~30초대가 됐다.
#    20초로 두면 재시도 3회가 전부 타임아웃해 계획 전 구간이 자리표시자가 된다(실측).
LLM_PLANNING_THINKING_BUDGET=2048
LLM_PLANNING_TIMEOUT_SECONDS=45.0
# 일일 토큰 한도 (in+out 합산, 사용자당). 0 이면 무제한.
LLM_DAILY_TOKEN_BUDGET=200000
# 일일 토큰 한도 (in+out 합산, 전 사용자 합산 — #325). 사용자별 한도보다 먼저 걸린다.
# 0 이면 무제한. 사용자별 한도의 대략 N배(동시 활성 사용자 수 추정치)로 잡을 것.
LLM_GLOBAL_DAILY_TOKEN_BUDGET=2000000
# 비싼 엔드포인트(interview/planning/recovery) 사용자별 일일 **호출 횟수** 상한 (#325).
# 토큰 예산과 별개 축 — 이건 초과 시 조용한 룰 폴백이 아니라 429 로 명시 거절한다.
# 0 이면 무제한.
LLM_ENDPOINT_DAILY_CALL_LIMIT=20
# 유료 전환 시 1K 토큰당 USD ¢ — Flash 무료 티어 = 0.
LLM_COST_PER_1K_INPUT_CENTS=0.0
LLM_COST_PER_1K_OUTPUT_CENTS=0.0

# ───── Auth (Issue #16) ─────

# Google OAuth client — Google Cloud Console에서 발급한 web application client.
# FE/BE가 같은 client_id를 공유해야 id_token.aud 검증이 맞물린다.
# local 개발은 AUTH_STUB_MODE=true 로 우회 가능 (아래 참고).
# GOOGLE_OAUTH_CLIENT_ID=
# Android 네이티브 로그인(Credential Manager) 전용 client — 웹과 다른 OAuth Client 발급이
# 필요하다(#322). 패키지명 com.hanium.reaction + SHA-1 3종(개발/업로드/Play App Signing)을
# Google Cloud 콘솔에 등록해야 발급됨. 미설정 시 웹 client_id 하나만 aud 로 허용(기존 동작).
# GOOGLE_OAUTH_ANDROID_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=  # SPA + id_token 흐름에서는 BE 미사용. server-side flow 대비 자리.
# GOOGLE_OAUTH_REDIRECT_URI=   # Issue #6 캘린더 OAuth 에서 사용 예정.

# JWT — HS256. SECRET 은 32+ bytes 랜덤: python -c "import secrets; print(secrets.token_hex(32))"
# JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_TTL_MINUTES=60
JWT_REFRESH_TOKEN_TTL_DAYS=14

# Local stub 모드 — Google id_token 검증 우회 + demo user 발급. staging/prod 는 반드시 false.
# id_token 값: 기본(아무 문자열) → 고정 demo 계정(시드 시나리오와 매칭).
#              "demo:<임의 id>" → 브라우저별 격리 데모 계정 (여러 테스터 동시 사용).
AUTH_STUB_MODE=true

# Encryption (calendar tokens, failure memos, LLM payload)
# 32-byte urlsafe base64. 생성: python -m reaction_backend.safety.encryption
COLUMN_ENCRYPTION_KEY=

# ───── Web Push VAPID (Issue #16/#20) ─────

# 비어있으면 발송이 조용히 skip (앱·cron 은 정상 — 로컬 기본값).
# 라이브(EC2)는 provision-vapid.yml 워크플로가 생성/주입 — private key 를 레포·로그에
# 절대 남기지 않는다. public key 는 FE `pushManager.subscribe(applicationServerKey)` 용 공개값.
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:j07801@hanyang.ac.kr

# ───── Scheduler (Issue #24) ─────

# true 면 앱 기동 시 in-process cron 등록 (라이브 전용 — toggle-scheduler.yml 로 제어).
SCHEDULER_ENABLED=false

# ───── 가입 게이트 (Issue #324) ─────

# false 면 신규 가입을 전부 막는다(기존 로그인은 영향 없음) — 긴급 차단, 재배포 없이
# toggle-signups.yml 로 제어.
SIGNUPS_ENABLED=true
# 누적 가입 인원 상한. Play 첫 공개는 30명(#237).
SIGNUP_CAPACITY=30
